{ "type": "Feature", "properties": { "fid": 20, "GID": 37.0, "TERRIT_P": "PT_OUEST", "GO_DESCRITION": "amgt liaison douce", "GPOLE_SUIVI_OPE_AMENAGEMENT_EP_COMMUNES": "Bruges", "GPOLE_SUIVI_OPE_AMENAGEMENT_EP_LIBELLE_PROJET": "BRUGE-016 ... Rue Pascal Triat", "GPOLE_SUIVI_OPE_AMENAGEMENT_EP_STATUT_PROJET": "Conception", "GPOLE_SUIVI_OPE_AMENAGEMENT_EP_CHEF_DE_PROJET": "MARCHAND Anne-Laure", "GPOLE_SUIVI_OPE_AMENAGEMENT_EP_DESCRIPTION_PROJET": "Requalification de la rue Pascal Triat dans le cadre du projet de liaison organique portée par la mission 1MA. Objectifs : très forte végétalisation de l'axe + mise en place du réseau REVE (entre allée de Bouléouts et route du Médoc) + évolution du schéma de circulation (mise à sens unique)", "GPOLE_SUIVI_OPE_AMENAGEMENT_EP_TYPE_PROJET": "Amgt EspPublic _ Géné", "GPOLE_SUIVI_OPE_AMENAGEMENT_EP_PROG_FIN_PRINC_SAU": "CODEV", "GPOLE_SUIVI_OPE_AMENAGEMENT_EP_DEBUT_TRAVAUX": 2028.0, "GPOLE_SUIVI_OPE_AMENAGEMENT_EP_FIN_TRAVAUX": 2028.0 }, "geometry": { "type": "MultiLineString", "coordinates": [ [ [ -0.617230802923233, 44.881376745347261 ], [ -0.6175228, 44.8805498 ], [ -0.617626, 44.880295700000097 ], [ -0.617730899999964, 44.8800482 ], [ -0.617784699999982, 44.879956699999987 ], [ -0.617844500000022, 44.879891400000027 ], [ -0.617953800000028, 44.879808700000048 ], [ -0.618186699999983, 44.879662600000039 ], [ -0.6181907330149, 44.87966023840675 ], [ -0.618440299999979, 44.879514100000044 ], [ -0.6188903, 44.8792738 ], [ -0.619079, 44.879167900000034 ], [ -0.619225, 44.879079800000035 ], [ -0.619312099999968, 44.879019400000026 ], [ -0.619454099999939, 44.878910300000037 ], [ -0.61969659999995, 44.878691400000015 ], [ -0.620096499999981, 44.878305100000034 ], [ -0.621011800000048, 44.877592300000046 ], [ -0.620999359344136, 44.877581603298871 ], [ -0.621011800000048, 44.877592300000046 ], [ -0.621143399999979, 44.877503 ], [ -0.621742699999958, 44.8770508 ], [ -0.6221009, 44.876799 ], [ -0.622097742748393, 44.876796806369747 ] ] ]